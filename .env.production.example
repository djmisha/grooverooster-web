# Production Environment Variables Template
# This file should be placed at /opt/grooverooster/.env on your VPS
# Copy this file and fill in the actual values

# ==============================================================================
# RUNTIME ENVIRONMENT VARIABLES (Server-Side Only)
# These variables are NOT included in the Docker build, they are passed at runtime
# ==============================================================================

# Supabase Configuration (Server-Side)
SUPABASE_URL=your-project-url.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Third-Party API Keys (Server-Side)
API_KEY_TICKETMASTER=your-ticketmaster-api-key
API_KEY_SDHM=your-sdhm-api-key
API_URL_SDHM=your-sdhm-api-url

# Authentication & Security
API_ALLOWED_TOKENS=token1,token2,token3

# HCaptcha Configuration (Server-Side)
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# GitHub Container Registry Access
# Create a Personal Access Token with read:packages scope
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Application Configuration
NODE_ENV=production

# ==============================================================================
# NOTES:
# ==============================================================================
# 
# 1. Build-time environment variables (NEXT_PUBLIC_*) are configured in:
#    - GitHub Actions Secrets (for CI/CD builds)
#    - They are NOT needed in this file
#
# 2. Keep this file secure:
#    chmod 600 .env
#
# 3. Never commit this file to version control
#
# 4. The docker-compose.yml file reads these variables automatically
#
# ==============================================================================
