#!/bin/bash

echo ""
echo "🚀 Starting pre-commit checks..."
echo ""

# Run Prettier format check
echo "💅 Checking code formatting..."
if ! npx prettier --check .; then
  echo ""
  echo "❌ Code formatting check failed. Run 'npx prettier --write .' to fix formatting issues."
  exit 1
fi
echo "✅ Code formatting passed!"
echo ""

# Run ESLint
echo "🔍 Running ESLint..."
if ! npx next lint; then
  echo ""
  echo "❌ ESLint failed. Please fix the errors before committing."
  exit 1
fi
echo "✅ ESLint passed!"
echo ""

# Run TypeScript compiler
echo "🔧 Running TypeScript compiler..."
if ! npx tsc --noEmit; then
  echo ""
  echo "❌ TypeScript compilation failed. Please fix the type errors before committing."
  exit 1
fi
echo "✅ TypeScript compilation passed!"
echo ""

echo "🎉 All pre-commit checks passed successfully!"
echo ""
