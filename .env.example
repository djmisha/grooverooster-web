# Supabase Configuration
# Get these values from your Supabase project dashboard (https://app.supabase.com)
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase keys (do not prefix with NEXT_PUBLIC)
SUPABASE_URL=your-project-url.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Third-Party API Keys
# EDM Train API - Used for fetching electronic music events
NEXT_PUBLIC_API_KEY_EDMTRAIN=your-edmtrain-api-key
NEXT_PUBLIC_API_URL_EDMTRAIN=https://edmtrain.com/api/events
NEXT_PUBLIC_API_URL_EDMTRAIN_ARTIST=https://edmtrain.com/api/artists

# Last.fm API - Used for artist information
NEXT_PUBLIC_API_KEY_LASTFM=your-lastfm-api-key

# Ticketmaster API - Used for event discovery
API_KEY_TICKETMASTER=your-ticketmaster-api-key

# SDHM API - Custom event API
API_KEY_SDHM=your-sdhm-api-key
API_URL_SDHM=your-sdhm-api-url

# Authentication & Security
# Comma-separated list of allowed API bearer tokens for authentication
API_ALLOWED_TOKENS=token1,token2,token3

# HCaptcha Configuration
# Get your site key from https://dashboard.hcaptcha.com/
# IMPORTANT: This key was previously hardcoded (74e2165e-2f0a-4314-9838-a5720a2e1fac)
# You should rotate to a new key for security
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# Application Configuration
# Base URL for your application (used for redirects and canonical URLs)
NEXT_PUBLIC_BASE_URL=https://www.grooverooster.com

# Environment
NODE_ENV=development
